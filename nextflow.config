
/*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config for INDUCE-seq processing pipeline
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/

def date = new java.util.Date().format( 'yyMMdd')

params {

    breaks = "data/breaks"
    asisi_sites = "data/chr21_AsiSI_sites.t2t.bed"

    outdir = "results"
}

process {

    executor = 'local'

    cpus = 1

    publishDir = [
        path: params.outdir,
        mode: 'copy'
    ]
}

timeline {
    enabled = true
    file    = "${params.outdir}/execution_timeline_${date}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/execution_report_${date}.html"
}


manifest {
    name            = 'INDUCE-seq processing pipeline'
    author          = 'Sam Devine'
    homePage        = 'https://github.com/SamSticksDevine/bsb-coding-test-advanced.git'
    description     = 'Quantifies and normalises INDUCE-seq break events overlapping predicted AsiSI sites on chr21.'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=21.10.3'
    version         = '0.1'
}
