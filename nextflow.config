
/*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config for INDUCE-seq processing pipeline
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/

params{

    // Input data
    breaks = "data/breaks"
    asisi_sites = "data/chr21_AsiSI_sites.t2t.bed"

    // Filtering thresholds
    min_mapq = 30

    // Output configuration
    outdir = "results/"
}


process {
    executor = 'local'   // local execution for portability
    cpus = 1             // single-core per process for lightweight parallelism
}

timeline {
    enabled = true
    file    = "${params.outdir}/execution_timeline.html" // workflow performance tracking
}
report {
    enabled = true
    file    = "${params.outdir}/execution_report.html"  // resource usage summary
}


manifest {
    name            = 'INDUCE-seq processing pipeline'
    author          = 'Sam Devine'
    homePage        = 'https://github.com/SamSticksDevine/bsb-coding-test-advanced.git'
    description     = 'Quantifies and normalises INDUCE-seq break events overlapping predicted AsiSI sites on chr21.'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=26'
    version         = '1.0'
}
